{
  "compilerOptions": {
    "module": "Node16",
    "target": "ES2022",
    "outDir": "out",
    "lib": ["ES2022"],
    "sourceMap": true,
    "rootDir": "src",
    "types": ["node", "mocha"],
    "strict": true
  },
  "watchOptions": {
    "excludeDirectories": ["**/node_modules", ".vscode-test", "out"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "out", ".vscode-test", "src/webview"]
}
