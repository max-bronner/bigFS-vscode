{
  "comments": {
    "lineComment": ";"
  },
  "brackets": [],
  "autoClosingPairs": [{ "open": "\"", "close": "\"" }],
  "surroundingPairs": [["\"", "\""]],
  "indentationRules": {
    "increaseIndentPattern": "$^",
    "decreaseIndentPattern": "^\\s*[Ee][Nn][Dd]\\s*(?:[;/].*)?$"
  },
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*"
}
