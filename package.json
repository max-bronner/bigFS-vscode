{
  "name": "bigfs",
  "displayName": "bigFS",
  "description": "Mod the Battle for Middle-earth games: edit BIG archives in place, write INI with full language support, and preview models, interface movies, maps, textures and sounds.",
  "version": "0.3.1",
  "publisher": "max-bronner",
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#1d2128",
    "theme": "dark"
  },
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/max-bronner/bigfs-vscode.git"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "bigFS writes archives, runs the game and FFmpeg, and reads settings that name executables, so it only runs in trusted folders."
    }
  },
  "engines": {
    "vscode": "^1.125.0",
    "node": ">=22"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "bfme",
    "bfme2",
    "rotwk",
    "battle for middle earth",
    "sage",
    "big",
    "w3d",
    "modding"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onFileSystem:bigfs",
    "onFileSystem:bigfs-apt-text"
  ],
  "main": "./dist/extension.mjs",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "bigArchiveExplorer",
          "name": "BIG Archives",
          "icon": "$(archive)"
        },
        {
          "id": "bigfs.search",
          "name": "Search in Archives",
          "type": "webview",
          "icon": "$(search)",
          "visibility": "collapsed"
        },
        {
          "id": "bigfs.converters",
          "name": "Converters",
          "type": "webview",
          "icon": "$(arrow-swap)",
          "visibility": "collapsed"
        },
        {
          "id": "bigfs.converterDrop",
          "name": "Drop Files",
          "icon": "$(cloud-download)",
          "visibility": "visible"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "bigArchiveExplorer",
        "contents": "Open a folder to load the BIG archives inside it.\n[Open Folder](command:vscode.openFolder)",
        "when": "workbenchState == empty"
      },
      {
        "view": "bigArchiveExplorer",
        "contents": "Searching for BIG archives...",
        "when": "workbenchState != empty && !bigfs.scanned"
      },
      {
        "view": "bigArchiveExplorer",
        "contents": "No BIG archives were found in this folder.\n[Refresh](command:bigfs.refreshArchives)",
        "when": "workbenchState != empty && bigfs.scanned && !bigfs.hasArchives"
      }
    ],
    "commands": [
      {
        "command": "bigfs.refreshArchives",
        "title": "Refresh Archives",
        "category": "bigFS",
        "icon": "$(refresh)"
      },
      {
        "command": "bigfs.openConverters",
        "title": "Open Converters",
        "category": "bigFS"
      },
      {
        "command": "bigfs.newArchive",
        "title": "New Archive…",
        "category": "bigFS",
        "icon": "$(new-file)"
      },
      {
        "command": "bigfs.newFile",
        "title": "New File…",
        "category": "bigFS",
        "icon": "$(new-file)"
      },
      {
        "command": "bigfs.newFolder",
        "title": "New Folder…",
        "category": "bigFS",
        "icon": "$(new-folder)"
      },
      {
        "command": "bigfs.rename",
        "title": "Rename…",
        "category": "bigFS"
      },
      {
        "command": "bigfs.delete",
        "title": "Delete",
        "category": "bigFS"
      },
      {
        "command": "bigfs.addFiles",
        "title": "Add Files…",
        "category": "bigFS"
      },
      {
        "command": "bigfs.extract",
        "title": "Extract…",
        "category": "bigFS"
      },
      {
        "command": "bigfs.cut",
        "title": "Cut",
        "category": "bigFS"
      },
      {
        "command": "bigfs.copy",
        "title": "Copy",
        "category": "bigFS"
      },
      {
        "command": "bigfs.paste",
        "title": "Paste",
        "category": "bigFS"
      },
      {
        "command": "bigfs.findGameInstalls",
        "title": "Find Game Installs…",
        "category": "bigFS"
      },
      {
        "command": "bigfs.duplicate",
        "title": "Duplicate",
        "category": "bigFS"
      },
      {
        "command": "bigfs.copyPath",
        "title": "Copy Path",
        "category": "bigFS"
      },
      {
        "command": "bigfs.copyRelativePath",
        "title": "Copy Relative Path",
        "category": "bigFS"
      },
      {
        "command": "bigfs.overrideInFolder",
        "title": "Override in Folder…",
        "category": "bigFS"
      },
      {
        "command": "bigfs.packFolder",
        "title": "Pack into BIG Archive…",
        "category": "bigFS"
      },
      {
        "command": "bigfs.chooseLanguage",
        "title": "Choose Game Language…",
        "category": "bigFS"
      },
      {
        "command": "bigfs.searchArchives",
        "title": "Search in Archives…",
        "category": "bigFS"
      },
      {
        "command": "bigfs.goToFile",
        "title": "Go to File in Archives…",
        "category": "bigFS"
      },
      {
        "command": "bigfs.validateIni",
        "title": "Validate INI Files",
        "category": "bigFS"
      },
      {
        "command": "bigfs.showGameView",
        "title": "Show What the Game Loads",
        "category": "bigFS",
        "icon": "$(layers)"
      },
      {
        "command": "bigfs.showArchiveView",
        "title": "Show Every Archive",
        "category": "bigFS",
        "icon": "$(archive)"
      },
      {
        "command": "bigfs.convertStringTable",
        "title": "Convert String Table (.str ⇄ .csf)",
        "category": "bigFS"
      },
      {
        "command": "bigfs.openStringTable",
        "title": "Open as Table",
        "category": "bigFS",
        "icon": "$(table)"
      },
      {
        "command": "bigfs.showWndPreview",
        "title": "Show Layout Preview",
        "category": "bigFS",
        "icon": "$(open-preview)"
      },
      {
        "command": "bigfs.exportPng",
        "title": "Export as PNG…",
        "category": "bigFS"
      },
      {
        "command": "bigfs.importImage",
        "title": "Replace with PNG…",
        "category": "bigFS"
      },
      {
        "command": "bigfs.convertPng",
        "title": "Convert to Game Texture…",
        "category": "bigFS"
      },
      {
        "command": "bigfs.exportCursorPng",
        "title": "Export Cursor as PNG…",
        "category": "bigFS"
      },
      {
        "command": "bigfs.convertPngToCursor",
        "title": "Convert to Cursor…",
        "category": "bigFS"
      },
      {
        "command": "bigfs.buildAnimatedCursor",
        "title": "Build Animated Cursor…",
        "category": "bigFS"
      },
      {
        "command": "bigfs.previewParticles",
        "title": "Preview Particle System",
        "category": "bigFS"
      },
      {
        "command": "bigfs.previewObject",
        "title": "Preview Object Here",
        "category": "bigFS"
      },
      {
        "command": "bigfs.newParticleSystem",
        "title": "New Particle System from Template…",
        "category": "bigFS"
      },
      {
        "command": "bigfs.bulkEditIni",
        "title": "Bulk Edit INI Values…",
        "category": "bigFS"
      },
      {
        "command": "bigfs.showEffectiveObject",
        "title": "Show Effective Definition",
        "category": "bigFS"
      },
      {
        "command": "bigfs.editMappedImageRegion",
        "title": "Edit MappedImage Region in Texture",
        "category": "bigFS"
      },
      {
        "command": "bigfs.showRuRegion",
        "title": "Show APT Geometry Texture Region",
        "category": "bigFS"
      },
      {
        "command": "bigfs.newObject",
        "title": "New Unit, Hero or Building…",
        "category": "bigFS"
      },
      {
        "command": "bigfs.newAptMovie",
        "title": "New APT Movie…",
        "category": "bigFS"
      },
      {
        "command": "bigfs.editCommandSet",
        "title": "Edit CommandSet Slots",
        "category": "bigFS"
      },
      {
        "command": "bigfs.showArmorTable",
        "title": "Armor Table",
        "category": "bigFS"
      },
      {
        "command": "bigfs.compareWithBaseGame",
        "title": "Compare with Base Game",
        "category": "bigFS"
      },
      {
        "command": "bigfs.compareWithOtherVersion",
        "title": "Compare with Other Version…",
        "category": "bigFS"
      },
      {
        "command": "bigfs.syncAssetCatalogue",
        "title": "Sync with Assets…",
        "category": "bigFS",
        "icon": "$(sync)"
      },
      {
        "command": "bigfs.restoreAssetCatalogue",
        "title": "Restore Original asset.dat",
        "category": "bigFS"
      },
      {
        "command": "bigfs.packageMod",
        "title": "Package Mod…",
        "category": "bigFS"
      },
      {
        "command": "bigfs.checkTranslations",
        "title": "Check Translations",
        "category": "bigFS"
      },
      {
        "command": "bigfs.launchGame",
        "title": "Launch Game with Mod",
        "category": "bigFS",
        "icon": "$(play)"
      },
      {
        "command": "bigfs.playAudioEvent",
        "title": "Play Audio Event",
        "category": "bigFS"
      },
      {
        "command": "bigfs.openBalanceSheet",
        "title": "Open Balance Sheet",
        "category": "bigFS"
      },
      {
        "command": "bigfs.duplicateDefinition",
        "title": "Duplicate Definition…",
        "category": "bigFS"
      },
      {
        "command": "bigfs.findUnusedDefinitions",
        "title": "Find Unused Definitions",
        "category": "bigFS"
      },
      {
        "command": "bigfs.clearUnusedDefinitions",
        "title": "Clear Unused Definitions",
        "category": "bigFS"
      },
      {
        "command": "bigfs.convertToVp6",
        "title": "Convert to VP6 Movie…",
        "category": "bigFS"
      },
      {
        "command": "bigfs.checkAptMovies",
        "title": "Check APT Movies",
        "category": "bigFS"
      },
      {
        "command": "bigfs.renameAptMovie",
        "title": "Rename APT Movie…",
        "category": "bigFS"
      },
      {
        "command": "bigfs.openAptText",
        "title": "Open APT as Text",
        "category": "bigFS",
        "icon": "$(file-code)"
      },
      {
        "command": "bigfs.reopenAptVisual",
        "title": "Reopen as Visual Editor",
        "category": "bigFS",
        "icon": "$(preview)"
      },
      {
        "command": "bigfs.editW3dAnimation",
        "title": "Edit W3D Animation…",
        "category": "bigFS"
      },
      {
        "command": "bigfs.deleteAptMovie",
        "title": "Delete APT Movie…",
        "category": "bigFS"
      }
    ],
    "submenus": [
      {
        "id": "bigfs.textureActions",
        "label": "Texture"
      },
      {
        "id": "bigfs.cursorActions",
        "label": "Cursor"
      },
      {
        "id": "bigfs.movieActions",
        "label": "Movie"
      },
      {
        "id": "bigfs.stringTableActions",
        "label": "String Table"
      },
      {
        "id": "bigfs.aptMovieActions",
        "label": "APT Movie"
      },
      {
        "id": "bigfs.modelActions",
        "label": "Model"
      },
      {
        "id": "bigfs.iniActions",
        "label": "bigFS"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "bigfs.showGameView",
          "group": "navigation@0",
          "when": "view == bigArchiveExplorer && !bigfs.gameView"
        },
        {
          "command": "bigfs.showArchiveView",
          "group": "navigation@0",
          "when": "view == bigArchiveExplorer && bigfs.gameView"
        },
        {
          "command": "bigfs.refreshArchives",
          "group": "navigation@1",
          "when": "view == bigArchiveExplorer"
        },
        {
          "command": "bigfs.searchArchives",
          "group": "1_search@1",
          "when": "view == bigArchiveExplorer"
        },
        {
          "command": "bigfs.goToFile",
          "group": "1_search@2",
          "when": "view == bigArchiveExplorer"
        },
        {
          "command": "bigfs.validateIni",
          "group": "2_check@1",
          "when": "view == bigArchiveExplorer"
        },
        {
          "command": "bigfs.findUnusedDefinitions",
          "group": "2_check@2",
          "when": "view == bigArchiveExplorer"
        },
        {
          "command": "bigfs.checkTranslations",
          "group": "2_check@3",
          "when": "view == bigArchiveExplorer"
        },
        {
          "command": "bigfs.checkAptMovies",
          "group": "2_check@4",
          "when": "view == bigArchiveExplorer"
        },
        {
          "command": "bigfs.compareWithBaseGame",
          "group": "2_check@5",
          "when": "view == bigArchiveExplorer"
        },
        {
          "command": "bigfs.syncAssetCatalogue",
          "group": "2_check@6",
          "when": "view == bigArchiveExplorer"
        },
        {
          "command": "bigfs.openBalanceSheet",
          "group": "3_tables@1",
          "when": "view == bigArchiveExplorer"
        },
        {
          "command": "bigfs.showArmorTable",
          "group": "3_tables@2",
          "when": "view == bigArchiveExplorer"
        },
        {
          "command": "bigfs.packageMod",
          "group": "4_mod@1",
          "when": "view == bigArchiveExplorer"
        },
        {
          "command": "bigfs.launchGame",
          "group": "4_mod@2",
          "when": "view == bigArchiveExplorer"
        },
        {
          "command": "bigfs.findGameInstalls",
          "group": "5_game@1",
          "when": "view == bigArchiveExplorer"
        },
        {
          "command": "bigfs.chooseLanguage",
          "group": "5_game@2",
          "when": "view == bigArchiveExplorer"
        }
      ],
      "view/item/context": [
        {
          "command": "bigfs.newArchive",
          "group": "navigation@1",
          "when": "view == bigArchiveExplorer && viewItem =~ /^big(Source|DiskFolder)$/"
        },
        {
          "command": "bigfs.newFile",
          "group": "navigation@1",
          "when": "view == bigArchiveExplorer && viewItem =~ /^big(Archive|Folder)$/"
        },
        {
          "command": "bigfs.newFolder",
          "group": "navigation@2",
          "when": "view == bigArchiveExplorer && viewItem =~ /^big(Archive|Folder)$/"
        },
        {
          "command": "bigfs.addFiles",
          "group": "navigation@3",
          "when": "view == bigArchiveExplorer && viewItem =~ /^big(Archive|Folder)$/"
        },
        {
          "command": "bigfs.extract",
          "group": "3_extract@1",
          "when": "view == bigArchiveExplorer && viewItem =~ /^big(Archive|Folder|File|GameFolder)(ReadOnly)?(:|$)/"
        },
        {
          "command": "bigfs.overrideInFolder",
          "group": "3_extract@2",
          "when": "view == bigArchiveExplorer && viewItem =~ /^big(Folder|File|GameFolder)(ReadOnly)?(:|$)/"
        },
        {
          "command": "bigfs.compareWithOtherVersion",
          "group": "3_compare@1",
          "when": "view == bigArchiveExplorer && viewItem =~ /^big(File|LooseFile)(ReadOnly)?:(ini|inc)$/"
        },
        {
          "submenu": "bigfs.textureActions",
          "group": "4_format@1",
          "when": "view == bigArchiveExplorer && (viewItem =~ /^big(File|FileReadOnly|LooseFile):(tga|dds)$/ || viewItem =~ /^big(File|LooseFile):png$/)"
        },
        {
          "submenu": "bigfs.cursorActions",
          "group": "4_format@2",
          "when": "view == bigArchiveExplorer && viewItem =~ /^big(File|LooseFile)(ReadOnly)?:(cur|ani|png)$/"
        },
        {
          "submenu": "bigfs.movieActions",
          "group": "4_format@3",
          "when": "view == bigArchiveExplorer && viewItem =~ /^big(File|LooseFile):(mp4|m4v|mov|webm|ogv|ogg|mkv|avi|wmv|mpg|mpeg|gif)$/"
        },
        {
          "submenu": "bigfs.stringTableActions",
          "group": "4_format@4",
          "when": "view == bigArchiveExplorer && viewItem =~ /^big(File|LooseFile):(str|csf)$/"
        },
        {
          "submenu": "bigfs.aptMovieActions",
          "group": "4_format@5",
          "when": "view == bigArchiveExplorer && (viewItem =~ /^big(File|LooseFile)(ReadOnly)?:apt$/ || viewItem =~ /^big(Archive|Folder)$/)"
        },
        {
          "submenu": "bigfs.modelActions",
          "group": "4_format@6",
          "when": "view == bigArchiveExplorer && viewItem =~ /^big(File|LooseFile):w3d$/"
        },
        {
          "command": "bigfs.restoreAssetCatalogue",
          "group": "4_format@7",
          "when": "view == bigArchiveExplorer && viewItem =~ /^bigLooseFile:dat\\+original$/"
        },
        {
          "command": "bigfs.cut",
          "group": "5_cutcopypaste@1",
          "when": "view == bigArchiveExplorer && viewItem =~ /^big(File|Folder)(:|$)/"
        },
        {
          "command": "bigfs.copy",
          "group": "5_cutcopypaste@2",
          "when": "view == bigArchiveExplorer && viewItem =~ /^big(File|Folder)(ReadOnly)?(:|$)/"
        },
        {
          "command": "bigfs.paste",
          "group": "5_cutcopypaste@3",
          "when": "view == bigArchiveExplorer && bigfs.hasClipboard && viewItem =~ /^big(Archive|Folder)$/"
        },
        {
          "command": "bigfs.duplicate",
          "group": "5_cutcopypaste@4",
          "when": "view == bigArchiveExplorer && viewItem =~ /^big(File|Folder)(:|$)/"
        },
        {
          "command": "bigfs.copyPath",
          "group": "6_copypath@1",
          "when": "view == bigArchiveExplorer && viewItem =~ /^big(Archive|File|Folder)(ReadOnly)?(:|$)/"
        },
        {
          "command": "bigfs.copyRelativePath",
          "group": "6_copypath@2",
          "when": "view == bigArchiveExplorer && viewItem =~ /^big(File|Folder)(ReadOnly)?(:|$)/"
        },
        {
          "command": "bigfs.rename",
          "group": "7_modification@1",
          "when": "view == bigArchiveExplorer && viewItem =~ /^big(Archive|File|Folder)(:|$)/"
        },
        {
          "command": "bigfs.delete",
          "group": "7_modification@2",
          "when": "view == bigArchiveExplorer && viewItem =~ /^big(Archive|File|Folder)(:|$)/"
        }
      ],
      "explorer/context": [
        {
          "command": "bigfs.compareWithOtherVersion",
          "group": "3_compare@1",
          "when": "resourceExtname =~ /^\\.(ini|inc)$/i"
        },
        {
          "submenu": "bigfs.textureActions",
          "group": "4_format@1",
          "when": "resourceExtname =~ /^\\.(tga|dds|png)$/i"
        },
        {
          "submenu": "bigfs.cursorActions",
          "group": "4_format@2",
          "when": "resourceExtname =~ /^\\.(cur|ani|png|tga)$/i"
        },
        {
          "submenu": "bigfs.movieActions",
          "group": "4_format@3",
          "when": "resourceExtname =~ /^\\.(mp4|m4v|mov|webm|ogv|ogg|mkv|avi|wmv|mpg|mpeg|gif|bik|png|tga|dds)$/i || explorerResourceIsFolder"
        },
        {
          "submenu": "bigfs.stringTableActions",
          "group": "4_format@4",
          "when": "resourceExtname =~ /^\\.(str|csf)$/i"
        },
        {
          "submenu": "bigfs.aptMovieActions",
          "group": "4_format@5",
          "when": "resourceExtname =~ /^\\.apt$/i || explorerResourceIsFolder"
        },
        {
          "submenu": "bigfs.modelActions",
          "group": "4_format@6",
          "when": "resourceExtname =~ /^\\.w3d$/i"
        },
        {
          "command": "bigfs.restoreAssetCatalogue",
          "group": "4_format@7",
          "when": "resourceFilename =~ /^asset\\.dat$/i && resourcePath in bigfs.restorableAssetCatalogues"
        },
        {
          "command": "bigfs.packFolder",
          "group": "4_mod@1",
          "when": "explorerResourceIsFolder"
        },
        {
          "command": "bigfs.launchGame",
          "group": "4_mod@2",
          "when": "explorerResourceIsFolder"
        }
      ],
      "editor/title": [
        {
          "command": "bigfs.syncAssetCatalogue",
          "group": "navigation",
          "when": "activeCustomEditorId == bigfs.assetCatalogue"
        },
        {
          "command": "bigfs.openAptText",
          "group": "navigation",
          "when": "activeCustomEditorId == bigfs.aptEditor"
        },
        {
          "command": "bigfs.reopenAptVisual",
          "group": "navigation",
          "when": "resourceScheme == bigfs-apt-text"
        },
        {
          "command": "bigfs.openStringTable",
          "group": "navigation",
          "when": "editorLangId == sage-str"
        },
        {
          "command": "bigfs.showWndPreview",
          "group": "navigation",
          "when": "editorLangId == sage-wnd"
        }
      ],
      "editor/title/context": [
        {
          "command": "bigfs.compareWithOtherVersion",
          "group": "3_compare@1",
          "when": "resourceExtname =~ /^\\.(ini|inc)$/i"
        }
      ],
      "editor/context": [
        {
          "submenu": "bigfs.iniActions",
          "group": "2_bigfs@1",
          "when": "editorLangId == sage-ini"
        }
      ],
      "bigfs.textureActions": [
        {
          "command": "bigfs.exportPng",
          "group": "1_export@1",
          "when": "view == bigArchiveExplorer && viewItem =~ /^big(File|FileReadOnly|LooseFile):(tga|dds)$/ || view != bigArchiveExplorer && resourceExtname =~ /^\\.(tga|dds)$/i"
        },
        {
          "command": "bigfs.importImage",
          "group": "1_export@2",
          "when": "view == bigArchiveExplorer && viewItem =~ /^big(File|LooseFile):(tga|dds)$/ || view != bigArchiveExplorer && resourceExtname =~ /^\\.(tga|dds)$/i"
        },
        {
          "command": "bigfs.convertPng",
          "group": "2_convert@1",
          "when": "view == bigArchiveExplorer && viewItem =~ /^big(File|LooseFile):png$/ || view != bigArchiveExplorer && resourceExtname =~ /^\\.png$/i"
        }
      ],
      "bigfs.cursorActions": [
        {
          "command": "bigfs.exportCursorPng",
          "group": "1_export@1",
          "when": "view == bigArchiveExplorer && viewItem =~ /^big(File|LooseFile)(ReadOnly)?:(cur|ani)$/ || view != bigArchiveExplorer && resourceExtname =~ /^\\.(cur|ani)$/i"
        },
        {
          "command": "bigfs.convertPngToCursor",
          "group": "2_convert@1",
          "when": "view == bigArchiveExplorer && viewItem =~ /^big(File|LooseFile)(ReadOnly)?:png$/ || view != bigArchiveExplorer && resourceExtname =~ /^\\.png$/i"
        },
        {
          "command": "bigfs.buildAnimatedCursor",
          "group": "2_convert@2",
          "when": "view != bigArchiveExplorer && resourceExtname =~ /^\\.(png|cur|tga)$/i"
        }
      ],
      "bigfs.movieActions": [
        {
          "command": "bigfs.convertToVp6",
          "group": "1_convert@1",
          "when": "view == bigArchiveExplorer && viewItem =~ /^big(File|LooseFile):(mp4|m4v|mov|webm|ogv|ogg|mkv|avi|wmv|mpg|mpeg|gif)$/ || view != bigArchiveExplorer && (resourceExtname =~ /^\\.(mp4|m4v|mov|webm|ogv|ogg|mkv|avi|wmv|mpg|mpeg|gif|bik|png|tga|dds)$/i || explorerResourceIsFolder)"
        }
      ],
      "bigfs.stringTableActions": [
        {
          "command": "bigfs.convertStringTable",
          "group": "1_convert@1",
          "when": "view == bigArchiveExplorer && viewItem =~ /^big(File|LooseFile):(str|csf)$/ || view != bigArchiveExplorer && resourceExtname =~ /^\\.(str|csf)$/i"
        }
      ],
      "bigfs.aptMovieActions": [
        {
          "command": "bigfs.openAptText",
          "group": "1_open@1",
          "when": "view == bigArchiveExplorer && viewItem =~ /^big(File|LooseFile)(ReadOnly)?:apt$/ || view != bigArchiveExplorer && resourceExtname =~ /^\\.apt$/i"
        },
        {
          "command": "bigfs.renameAptMovie",
          "group": "2_modification@1",
          "when": "view == bigArchiveExplorer && viewItem =~ /^big(File|LooseFile):apt$/ || view != bigArchiveExplorer && resourceExtname =~ /^\\.apt$/i"
        },
        {
          "command": "bigfs.deleteAptMovie",
          "group": "2_modification@2",
          "when": "view == bigArchiveExplorer && viewItem =~ /^big(File|LooseFile):apt$/ || view != bigArchiveExplorer && resourceExtname =~ /^\\.apt$/i"
        },
        {
          "command": "bigfs.newAptMovie",
          "group": "3_new@1",
          "when": "view == bigArchiveExplorer && viewItem =~ /^big(Archive|Folder)$/ || view != bigArchiveExplorer && explorerResourceIsFolder"
        }
      ],
      "bigfs.modelActions": [
        {
          "command": "bigfs.editW3dAnimation",
          "group": "1_edit@1",
          "when": "view == bigArchiveExplorer && viewItem =~ /^big(File|LooseFile):w3d$/ || view != bigArchiveExplorer && resourceExtname =~ /^\\.w3d$/i"
        }
      ],
      "bigfs.iniActions": [
        {
          "command": "bigfs.previewObject",
          "group": "1_show@1"
        },
        {
          "command": "bigfs.previewParticles",
          "group": "1_show@2"
        },
        {
          "command": "bigfs.showEffectiveObject",
          "group": "1_show@3"
        },
        {
          "command": "bigfs.editMappedImageRegion",
          "group": "1_show@4"
        },
        {
          "command": "bigfs.newObject",
          "group": "2_create@1"
        },
        {
          "command": "bigfs.newParticleSystem",
          "group": "2_create@2"
        },
        {
          "command": "bigfs.duplicateDefinition",
          "group": "2_create@3"
        },
        {
          "command": "bigfs.bulkEditIni",
          "group": "2_create@4"
        },
        {
          "command": "bigfs.compareWithOtherVersion",
          "group": "3_compare@1"
        }
      ],
      "commandPalette": [
        {
          "command": "bigfs.restoreAssetCatalogue",
          "when": "activeCustomEditorId == bigfs.assetCatalogue"
        },
        {
          "command": "bigfs.compareWithOtherVersion",
          "when": "resourceExtname =~ /^\\.(ini|inc)$/i"
        },
        {
          "command": "bigfs.reopenAptVisual",
          "when": "resourceScheme == bigfs-apt-text"
        },
        {
          "command": "bigfs.editCommandSet",
          "when": "false"
        },
        {
          "command": "bigfs.newParticleSystem",
          "when": "editorLangId == sage-ini"
        },
        {
          "command": "bigfs.refreshArchives"
        },
        {
          "command": "bigfs.newArchive",
          "when": "false"
        },
        {
          "command": "bigfs.newFile",
          "when": "false"
        },
        {
          "command": "bigfs.newFolder",
          "when": "false"
        },
        {
          "command": "bigfs.rename",
          "when": "false"
        },
        {
          "command": "bigfs.delete",
          "when": "false"
        },
        {
          "command": "bigfs.addFiles",
          "when": "false"
        },
        {
          "command": "bigfs.extract",
          "when": "false"
        },
        {
          "command": "bigfs.cut",
          "when": "false"
        },
        {
          "command": "bigfs.copy",
          "when": "false"
        },
        {
          "command": "bigfs.paste",
          "when": "false"
        },
        {
          "command": "bigfs.duplicate",
          "when": "false"
        },
        {
          "command": "bigfs.copyPath",
          "when": "false"
        },
        {
          "command": "bigfs.copyRelativePath",
          "when": "false"
        },
        {
          "command": "bigfs.overrideInFolder",
          "when": "false"
        },
        {
          "command": "bigfs.packFolder",
          "when": "false"
        },
        {
          "command": "bigfs.openStringTable",
          "when": "editorLangId == sage-str"
        },
        {
