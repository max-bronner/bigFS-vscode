    "keybindings": [
      {
        "command": "bigfs.goToFile",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p"
      },
      {
        "command": "bigfs.rename",
        "key": "f2",
        "when": "focusedView == bigArchiveExplorer && !inputFocus"
      },
      {
        "command": "bigfs.delete",
        "key": "delete",
        "when": "focusedView == bigArchiveExplorer && !inputFocus"
      },
      {
        "command": "bigfs.cut",
        "key": "ctrl+x",
        "mac": "cmd+x",
        "when": "focusedView == bigArchiveExplorer && !inputFocus"
      },
      {
        "command": "bigfs.copy",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "focusedView == bigArchiveExplorer && !inputFocus"
      },
      {
        "command": "bigfs.paste",
        "key": "ctrl+v",
        "mac": "cmd+v",
        "when": "focusedView == bigArchiveExplorer && bigfs.hasClipboard && !inputFocus"
      }
    ],
    "configuration": [
      {
        "title": "Game and installs",
        "order": 1,
        "properties": {
          "bigfs.baseGameFolder": {
            "type": "string",
            "default": "",
            "scope": "machine",
            "markdownDescription": "Install folder of the unmodded game, the lowest layer of the game view: a mod-only or ROTWK-only workspace resolves the base files from it, and **bigFS: Compare with Base Game** compares against it. Asked for on first use. Each workspace folder resolves against its own game's installs, told by their marker files (`lotrbfme2ep1.exe` = ROTWK, `lotrbfme2.exe` = BFME II) or, for a mod folder, by `#bigfs.folderGame#`: a BFME II folder never sees ROTWK files.",
            "order": 1
          },
          "bigfs.underlyingGameFolder": {
            "type": "string",
            "default": "",
            "scope": "machine",
            "markdownDescription": "Install folder of the game beneath `#bigfs.baseGameFolder#`, such as BFME II when that is ROTWK, which keeps only what it adds. On Windows, empty finds BFME II from the registry as the game does.",
            "order": 2
          },
          "bigfs.folderGame": {
            "type": "string",
            "enum": [
              "auto",
              "bfme2",
              "rotwk"
            ],
            "enumDescriptions": [
              "ROTWK when a ROTWK install is open or named by the settings, otherwise BFME II.",
              "A BFME II mod: its files resolve against this folder, then BFME II.",
              "A ROTWK mod: its files resolve against this folder, then ROTWK, then BFME II."
            ],
            "default": "auto",
            "scope": "resource",
            "markdownDescription": "Which game a mod folder is for, set per workspace folder. It decides the load order the folder's files resolve against: the folder first, then that game's installs (`#bigfs.baseGameFolder#`, `#bigfs.underlyingGameFolder#` or install folders of the workspace). Install folders are told by their marker files (`lotrbfme2ep1.exe` = ROTWK, `lotrbfme2.exe` = BFME II) and ignore this setting: a BFME II install resolves against itself alone, a ROTWK install against itself, then BFME II. Other workspace folders never affect a folder's load order.",
            "order": 3
          },
          "bigfs.language": {
            "type": "string",
            "default": "auto",
            "markdownDescription": "The language the game's text is shown in: the `lang/<Language>.big` archive whose string table labels resolve against, such as `English`. `auto` uses the only language installed, and otherwise asks once and remembers the answer for the workspace.",
            "order": 4
          },
          "bigfs.game.executable": {
            "type": "string",
            "default": "",
            "scope": "machine",
            "markdownDescription": "The game program **bigFS: Launch Game with Mod** starts, such as `lotrbfme2ep1.exe` for The Rise of the Witch-king or `lotrbfme2.exe` for BFME II. Asked for on first use.",
            "order": 5
          },
          "bigfs.game.arguments": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "markdownDescription": "Extra arguments passed before `-mod`, such as `-win` or `-noshellmap`.",
            "order": 6
          }
        }
      },
      {
        "title": "Archives",
        "order": 2,
        "properties": {
          "bigfs.explorer.view": {
            "type": "string",
            "enum": [
              "archives",
              "game"
            ],
            "enumDescriptions": [
              "Every archive with all of its files",
              "Only the file the game loads at each path, layered by the engine's archive order: loose files before archives, archives sorted by path with the first winning, workspace folders in order with the first winning"
            ],
            "default": "archives",
            "description": "What the BIG Archives view shows.",
            "order": 1
          },
          "bigfs.protectGameArchives": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Keep the archives that came with the game read-only, so looking around an install opened in the workspace changes nothing by accident: in a BFME II or ROTWK install folder, the retail archives at its root (`INI.big`, `W3D.big`, ...) and every archive in its `apt` and `lang` folders. Your own archives beside them stay writable. An install outside the workspace is read-only whatever this says.",
            "order": 2
          }
        }
      },
      {
        "title": "INI",
        "order": 3,
        "properties": {
          "bigfs.ini.game": {
            "type": "string",
            "enum": [
              "rotwk",
              "bfme2",
              "bfme1"
            ],
            "enumDescriptions": [
              "The Rise of the Witch-king",
              "The Battle for Middle-earth II",
              "The Battle for Middle-earth: structure only, since no grammar of its own is available; field names are not checked"
            ],
            "default": "rotwk",
            "description": "The game whose INI grammar checks, completion and hovers follow. The two differ in a few dozen field names.",
            "order": 1
          },
          "bigfs.ini.checkReferences": {
            "type": "string",
            "enum": [
              "auto",
              "on",
              "off"
            ],
            "enumDescriptions": [
              "Check references into a kind of definition once the workspace holds at least 50 of them, so the base game's files are there",
              "Always check references, even with only a mod's own files open",
              "Never check references"
            ],
            "default": "auto",
            "description": "Whether a value naming a Weapon, Upgrade, FXList or other definition that nothing in the workspace defines is reported.",
            "order": 2
          },
          "bigfs.ini.checkAssets": {
            "type": "string",
            "enum": [
              "auto",
              "on",
              "off"
            ],
            "enumDescriptions": [
              "Check once a base game folder is set (bigfs.baseGameFolder) and the archives and folders hold its models, so a missing name is a mistake; without one the check stays off and says so once",
              "Always check, even with only a mod's own files open",
              "Never check"
            ],
            "default": "auto",
            "description": "Whether a model, animation, texture or sound an INI file names, which no archive or folder holds, is reported.",
            "order": 3
          },
          "bigfs.ini.checkStrings": {
            "type": "string",
            "enum": [
              "auto",
              "on",
              "off"
            ],
            "enumDescriptions": [
              "Check once the string tables hold at least 1000 records, so the base game's are there",
              "Always check, even with only a mod's own files open",
              "Never check"
            ],
            "default": "auto",
            "description": "Whether a game-text label such as OBJECT:Name that no string table defines is reported.",
            "order": 4
          }
        }
      },
      {
        "title": "Media tools",
        "order": 4,
        "properties": {
          "bigfs.ffmpegPath": {
            "type": "string",
            "default": "",
            "scope": "machine",
            "markdownDescription": "FFmpeg program **Convert to VP6 Movie** reads videos with. Empty: `ffmpeg` on the PATH; without one, only WebM and Ogg videos (and image frames) can be read.",
            "order": 1
          },
          "bigfs.vp6.keyFrameSeconds": {
            "type": "number",
            "default": 2,
            "minimum": 0,
            "markdownDescription": "Seconds between forced key frames when **Convert to VP6 Movie** encodes; scene changes add their own. 0 makes every frame a key frame, which seeks fastest and is largest.",
            "order": 2
          }
        }
      }
    ],
    "customEditors": [
      {
        "viewType": "bigfs.preview",
        "displayName": "bigFS Preview",
        "selector": [
