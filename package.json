  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && node esbuild.mjs",
    "package": "npm run check-types && npm run lint && node esbuild.mjs --production",
    "check-types": "tsc --noEmit && tsc --noEmit -p src/webview",
    "watch:esbuild": "node esbuild.mjs --watch",
    "watch:tsc": "tsc --noEmit --watch --preserveWatchOutput --project tsconfig.json",
    "compile-tests": "tsc -p ./ --outDir out --noCheck",
    "lint": "eslint src",
    "pretest": "npm run compile && npm run lint",
    "test": "npm run test:unit",
    "test:unit": "npm run compile-tests && mocha --ui tdd \"out/test/unit/**/*.test.js\"",
    "vsix": "vsce package --out bigfs.vsix",
    "check:cycles": "madge --circular --extensions ts src"
  },
  "devDependencies": {
    "@types/luaparse": "^0.2.13",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.0",
    "@types/vscode": "^1.125.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "madge": "^8.0.0",
    "mocha": "^11.8.0",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "luaparse": "^0.3.1"
  },
  "overrides": {
    "typescript": "$typescript"
  }
}
