          }
        ],
        "priority": "default"
      }
    ],
    "languages": [
      {
        "id": "sage-ini",
        "aliases": [
          "SAGE INI",
          "BFME INI"
        ],
        "extensions": [
          ".inc",
          ".bhav"
        ],
        "configuration": "./language-configuration.json"
